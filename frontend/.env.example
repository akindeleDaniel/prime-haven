# Public site origin for canonical and social metadata. This is not a secret.
# Copy to .env.local for local configuration; set the real origin before deployment.
SITE_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:3001
# Explicit exception only for HTTP loopback during local development/testing.
AUTH_ALLOW_LOCAL_HTTP=true
# Generate at least 32 random bytes; match backend. Never prefix this with NEXT_PUBLIC_.
BFF_SHARED_SECRET=
