# ZeptoMail send-mail token and verified sender address. Keep these server-only.
ZEPTOMAIL_API_TOKEN=
ZEPTOMAIL_FROM_EMAIL=
ZEPTOMAIL_FROM_NAME=Prime Haven Properties
