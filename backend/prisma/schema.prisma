generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  AGENT
  ADMINISTRATOR
}

enum AccountStatus {
  ACTIVE
  DEACTIVATED
}

enum InvitationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum AuditAction {
  AGENT_CREATED
  INVITATION_ISSUED
  PASSWORD_ACTIVATED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET
  PASSWORD_CHANGED
  PROPERTY_CREATED
  PROPERTY_EDITED
  PROPERTY_DUPLICATED
}

enum AuditSubjectType {
  USER
  SECURITY
  PROPERTY
}

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  name                String
  email               String        @unique
  phone               String
  photoUrl            String?
  biography           String?
  passwordHash        String?
  passwordActivatedAt DateTime?     @db.Timestamptz(3)
  role                UserRole
  accountStatus       AccountStatus @default(ACTIVE)
  deactivatedAt       DateTime?     @db.Timestamptz(3)
  failedLoginCount    Int           @default(0)
  lockoutUntil        DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  sessions            Session[]
  invitations         Invitation[]
  passwordResetTokens PasswordResetToken[]
  actorAuditEvents    AuditLog[]    @relation("AuditActor")
  subjectAuditEvents  AuditLog[]    @relation("AuditAffectedUser")
  properties          Property[]   @relation("PropertyOwner")
  verifiedProperties  Property[]   @relation("PropertyVerifier")
  uploadedAssets      CloudinaryAsset[]
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  lastActivityAt    DateTime  @db.Timestamptz(3)
  idleExpiresAt     DateTime  @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
}

model Invitation {
  id             String                   @id @default(uuid()) @db.Uuid
  userId         String                   @db.Uuid
  tokenHash      String                   @unique
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime                 @db.Timestamptz(3)
  consumedAt     DateTime?                @db.Timestamptz(3)
  revokedAt      DateTime?                @db.Timestamptz(3)
  deliveryStatus InvitationDeliveryStatus @default(PENDING)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, consumedAt])
  @@index([expiresAt])
}

model AuditLog {
  id               String           @id @default(uuid()) @db.Uuid
  actorId          String?          @db.Uuid
  affectedUserId   String?          @db.Uuid
  propertyId       String?          @db.Uuid
  action           AuditAction
  subjectType      AuditSubjectType
  subjectReference String
  summary          String
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  actor            User?            @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  affectedUser     User?            @relation("AuditAffectedUser", fields: [affectedUserId], references: [id], onDelete: SetNull)
  property         Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([affectedUserId, createdAt])
}

enum PropertyPurpose {
  FOR_SALE
  FOR_RENT
}
enum PropertyType {
  HOUSE
  APARTMENT_FLAT
  DUPLEX
  TERRACE
  LAND
  COMMERCIAL
  OFFICE
  SHOP
}
enum RentPeriod {
  PER_YEAR
  PER_MONTH
}
enum Furnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FURNISHED
}
enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  UNDER_OFFER
  CLOSED
  ARCHIVED
}
enum NigerianState {
  Abia
  Adamawa
  Akwa_Ibom @map("Akwa Ibom")
  Anambra
  Bauchi
  Bayelsa
  Benue
  Borno
  Cross_River @map("Cross River")
  Delta
  Ebonyi
  Edo
  Ekiti
  Enugu
  FCT
  Gombe
  Imo
  Jigawa
  Kaduna
  Kano
  Katsina
  Kebbi
  Kogi
  Kwara
  Lagos
  Nasarawa
  Niger
  Ogun
  Ondo
  Osun
  Oyo
  Plateau
  Rivers
  Sokoto
  Taraba
  Yobe
  Zamfara
}

model Property {
  id                String          @id @default(uuid()) @db.Uuid
  ownerId           String          @db.Uuid
  reference         String          @unique @default(dbgenerated("next_property_reference()"))
  status            PropertyStatus  @default(DRAFT)
  version           Int             @default(1)
  title             String?
  description       String?
  purpose           PropertyPurpose?
  propertyType      PropertyType?
  priceNaira        BigInt?
  negotiable        Boolean         @default(false)
  state             NigerianState?
  city              String?
  neighbourhood     String?
  exactAddress      String?
  showExactAddress  Boolean         @default(true)
  rentPeriod        RentPeriod?
  furnishing        Furnishing?
  bedrooms          Int?
  bathrooms         Int?
  toilets           Int?
  parkingSpaces     Int?
  floorAreaSqm      Decimal?        @db.Decimal(12, 2)
  plotSizeSqm       Decimal?        @db.Decimal(12, 2)
  titleDocumentType String?
  slug              String?         @unique
  publishedAt       DateTime?       @db.Timestamptz(3)
  submittedAt       DateTime?       @db.Timestamptz(3)
  archivedAt        DateTime?       @db.Timestamptz(3)
  rejectionReason   String?
  verified          Boolean         @default(false)
  verifiedById      String?         @db.Uuid
  verifiedAt        DateTime?       @db.Timestamptz(3)
  featured          Boolean         @default(false)
  featuredAt        DateTime?       @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  owner             User            @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  verifier          User?           @relation("PropertyVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  amenities         PropertyAmenity[]
  auditEvents       AuditLog[]
  images            PropertyImage[]
  assets            CloudinaryAsset[]

  @@index([ownerId, status, updatedAt, id])
}

enum AssetState {
  UPLOADING
  READY
  DELETE_PENDING
  DELETED
}

model CloudinaryAsset {
  id                 String     @id @default(uuid()) @db.Uuid
  propertyId         String?    @db.Uuid
  uploadedById       String     @db.Uuid
  cloudinaryPublicId String     @unique
  lifecycle          AssetState @default(UPLOADING)
  declaredMimeType   String
  declaredByteSize   Int
  authorizedUntil    DateTime   @db.Timestamptz(3)
  uploadStartedAt    DateTime?  @db.Timestamptz(3)
  uploadedAt         DateTime?  @db.Timestamptz(3)
  contentHash        String?
  deliveryUrl        String?
  mimeType           String?
  format             String?
  byteSize           Int?
  width              Int?
  height             Int?
  verifiedAt         DateTime?  @db.Timestamptz(3)
  deleteAfter        DateTime?  @db.Timestamptz(3)
  deletedAt          DateTime?  @db.Timestamptz(3)
  lastErrorCode      String?
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)
  property           Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  uploadedBy         User       @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  image              PropertyImage?
  @@index([lifecycle, deleteAfter])
  @@index([propertyId])
}

model PropertyImage {
  id         String    @id @default(uuid()) @db.Uuid
  propertyId String    @db.Uuid
  assetId    String    @unique @db.Uuid
  position   Int
  isCover    Boolean
  caption    String
  altText    String
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  asset      CloudinaryAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  @@unique([propertyId, position])
}

model Amenity {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @unique
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String   @db.Uuid
  amenityId  String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Restrict)
  @@id([propertyId, amenityId])
  @@index([amenityId, propertyId])
}
