{
  "name": "prime-haven-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express TypeScript backend for Prime Haven Properties",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "type-check": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:local": "tsx scripts/migrate-local.ts",
    "admin:init": "tsx scripts/bootstrap-admin.ts",
    "test": "node --import tsx --test tests/auth.test.ts",
    "type-check:tools": "tsc --noEmit --project tsconfig.tools.json",
    "images:cleanup": "tsx scripts/cleanup-images.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.16.3",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "effect": "3.22.1"
  }
}
